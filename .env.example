# ==============================================================================
# Multi-Agent Research Assistant - Backend Environment Variables
# ==============================================================================

# Required: Groq API key (used by langchain_groq for Search, Reader, Writer, and Critic agents)
GROQ_API_KEY=your_groq_api_key_here

# Required: Tavily API key (used by TavilyClient for live web search in tools.py)
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Optional / Evaluation-Only Variables
# ------------------------------------------------------------------------------
# Model used by the evaluation harness judge in run_evals.py
# Defaults to "openai/gpt-oss-120b" if not specified.
JUDGE_MODEL=openai/gpt-oss-120b
